// Version information of the DLL, shown in the Explorer file properties.
// Compiled by `windres` from build.rs. `version.h` is generated from the Cargo package version.

#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION  VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		// U.S. English, Unicode
		BLOCK "040904B0"
		BEGIN
			VALUE "Comments",         "Helper functions for Notepad++. Licensed under the MIT license."
			VALUE "CompanyName",      "Daniel Starke"
			VALUE "FileDescription",  "NppToolBox plugin for Notepad++"
			VALUE "FileVersion",      VERSION_STRING
			VALUE "InternalName",     "NppToolBox"
			VALUE "LegalCopyright",   "Copyright (c) 2026 Daniel Starke"
			VALUE "OriginalFilename", "NppToolBox.dll"
			VALUE "ProductName",      "NppToolBox"
			VALUE "ProductVersion",   VERSION_STRING
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
